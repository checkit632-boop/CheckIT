PORT=4000
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta
NODE_ENV=development

# Nombre de la empresa mostrado en reportes y correos
EMPRESA_NOMBRE=TECNOSOFT

# Configuración SMTP para el envío real de correos ("olvidé mi contraseña" y
# el PIN del tercer factor de seguridad al iniciar sesión). Si se deja vacío,
# el sistema sigue funcionando en modo de prueba: el código se imprime en la
# consola del servidor y, fuera de producción, también se incluye en la
# respuesta de la API (campo dev_codigo) — pero NO llega a ningún correo real.
#
# Ejemplo con Gmail (requiere una "Contraseña de aplicación" de 16
# caracteres, NO la contraseña normal de la cuenta — ver README):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=checkit632@gmail.com
SMTP_PASS=
SMTP_FROM=CheckIT <checkit632@gmail.com>
