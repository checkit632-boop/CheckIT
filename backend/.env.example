PORT=4000
# NC-6: obligatorio — el servidor ya no arranca sin esto (ya no hay un
# secreto de respaldo escrito en el código). Genera uno propio, largo y
# aleatorio (ej. ejecuta en una terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta
NODE_ENV=development

# Nombre de la empresa mostrado en reportes y correos
EMPRESA_NOMBRE=TECNOSOFT

# Configuración SMTP para el envío real de correos ("olvidé mi contraseña" y
# el PIN del tercer factor de seguridad al iniciar sesión). Si se deja vacío,
# el sistema sigue funcionando en modo de prueba: el código se imprime en la
# consola del servidor y, fuera de producción, también se incluye en la
# respuesta de la API (campo dev_codigo) — pero NO llega a ningún correo real.
#
# Ejemplo con Gmail (requiere una "Contraseña de aplicación" de 16
# caracteres, NO la contraseña normal de la cuenta — ver README):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=checkit632@gmail.com
SMTP_PASS=
SMTP_FROM=CheckIT <checkit632@gmail.com>

# Respaldo automático de la base de datos. BACKUP_DIR_1 debe estar en un
# disco/unidad DISTINTO al de este proyecto (ej. una unidad USB o un disco
# externo). BACKUP_DIR_2 es opcional pero recomendado: un tercer lugar
# aparte (otra unidad, o una carpeta sincronizada con la nube como Google
# Drive o OneDrive) — así, si un disco falla, sigue habiendo una copia en
# otro lado. Se ejecuta solo, una vez al día, a la hora en BACKUP_HORA
# (también puedes correrlo tú mismo cuando quieras con: npm run backup).
BACKUP_DIR_1=E:\Respaldos_CheckIT
BACKUP_DIR_2=
BACKUP_HORA=02:00
BACKUP_RETENCION=14
